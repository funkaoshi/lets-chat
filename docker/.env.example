# Copy this file to .env in the same directory and fill in real values.
# docker/.env is gitignored; any LCB_* var added here is passed to the app
# container as an environment variable (Let's Chat config override).
#
# YAML keys map to env vars with camelCase boundaries converted to underscores:
#   giphy.apiKey       -> LCB_GIPHY_API_KEY
#   secrets.cookie     -> LCB_SECRETS_COOKIE
#   database.uri       -> LCB_DATABASE_URI

# ---------------------------------------------------------------------------
# Session cookie signing secret. Defaults to literal "secretsauce" -- every
# Let's Chat install with the default value shares the same predictable key,
# so any internet-exposed deployment with the default lets an attacker forge
# session cookies. Generate one per deployment, e.g.:
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
LCB_SECRETS_COOKIE=

# ---------------------------------------------------------------------------
# Giphy: get a free API key at https://developers.giphy.com
# Without a valid key the default demo key gets a 403 BANNED from Giphy.
# ---------------------------------------------------------------------------
LCB_GIPHY_API_KEY=

# To disable Giphy entirely instead of supplying a key:
# LCB_GIPHY_ENABLE=false

# ---------------------------------------------------------------------------
# MongoDB connection. The default in docker-compose.yml is the internal mongo
# service on the private network (no auth needed). If you point at an
# external mongo, the URI will contain credentials -- set it here instead so
# they stay out of the committed compose file:
#   LCB_DATABASE_URI=mongodb://user:password@host:27017/letschat
# ---------------------------------------------------------------------------
# LCB_DATABASE_URI=

# ---------------------------------------------------------------------------
# Optional auth-provider plugin credentials. Only relevant if you enable the
# matching provider in LCB_AUTH_PROVIDERS and install the plugin package
# (e.g. lets-chat-ldap, lets-chat-kerberos). See each plugin's README for
# the full list of LCB_LDAP_* / LCB_KERBEROS_* vars.
# ---------------------------------------------------------------------------
# LCB_AUTH_PROVIDERS=local,ldap
# LCB_LDAP_BIND_CREDENTIALS=

# ---------------------------------------------------------------------------
# Optional file-storage provider credentials. Only relevant if you switch
# files.provider away from `local` (e.g. lets-chat-s3, lets-chat-azure).
# ---------------------------------------------------------------------------
# LCB_FILES_PROVIDER=s3
# LCB_FILES_S3_ACCESS_KEY=
# LCB_FILES_S3_SECRET_KEY=
